# Copy to .env (git-ignored) and fill in ONE key. The assistant uses the first it finds:
# Claude -> OpenAI -> Gemini. Leave all empty to run offline (quotes clauses).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider (claude | openai | gemini | extractive) or change models
# RAG_PROVIDER=gemini
# RAG_GEMINI_MODEL=gemini-3.5-flash
